# Hugging Face API token for downloading gated models
HF_TOKEN=some_token_value

# Path to the SwiftLM binary
SWIFT_BIN=storage/runtimes/swiftlm/bin/SwiftLM

# Primary model profile name (required) — must match a file in storage/project-local-config/profiles/models/
MODEL_MAIN_PROFILE=swiftlm-Qwen3.5-35B-A3B-8bit

# Draft/speculative decoding model profile name (optional) — used by dev-* commands
MODEL_DRAFT_PROFILE=swiftlm-AC-Qwen3.5-2B-8bit

# Number of days to retain log files before rotation
LOG_ROTATION_DAYS=5

# Directory where profile logs are written
LOG_PROFILE_PATH=storage/logs/profiles

# Root storage directory for runtimes, configs, and logs
STORAGE_PATH=storage